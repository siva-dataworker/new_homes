# ============================================================
# Essential Homes — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# Django Core — REQUIRED, no defaults (app will refuse to start if missing)
SECRET_KEY=your-long-random-secret-key-here
JWT_SECRET_KEY=your-long-random-jwt-secret-key-here

# To generate secure keys run:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# Server
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Supabase PostgreSQL Database — REQUIRED
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-supabase-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432

# Supabase Storage (S3-compatible) — for uploaded photos/documents/bills.
# Get these from: Supabase Dashboard -> Project Settings -> Storage -> S3 Connection
# If left blank, uploads fall back to local disk storage on whatever server
# is running Django (fine for quick testing, not for real deployment).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=site-media
AWS_S3_ENDPOINT_URL=https://your-project-ref.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=us-east-1
